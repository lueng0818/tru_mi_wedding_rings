{
  "containerized": false,
  "routes": [
    {
      "src": "/",
      "status": 301,
      "headers": {
        "Location": "/tru_mi_wedding_rings/"
      }
    },
    {
      "src": "/tru_mi_wedding_rings/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/tru_mi_wedding_rings/.*",
      "dest": "/index.html"
    }
  ]
}